# Backend API
# Current backend: http://localhost:5005
NEXT_PUBLIC_API_URL=http://localhost:5005

# OAuth Redirect URL
# Current redirect host: http://localhost:3000
NEXT_PUBLIC_GOOGLE_REDIRECT_URL=http://localhost:3000/oauth-callback

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

# Facebook OAuth
NEXT_PUBLIC_FACEBOOK_APP_ID=your_facebook_app_id_here

# Apple OAuth
NEXT_PUBLIC_APPLE_CLIENT_ID=your_apple_client_id_here

# Email sending (Gmail SMTP) for "Send Full Report Link" on the inspection summary page.
# Generate an App Password at https://myaccount.google.com/apppasswords (requires 2FA enabled).
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_APP_PASSWORD=your_16_char_app_password
