{
  "appId": "com.nspireapp",
  "appName": "NSPIRE INSPECTION (Public)",
  "webDir": "www",
  "server": {
    "url": "https://nspireinspectionapp.com/app-launch",
    "cleartext": false
  },
  "ios": {
    "contentInset": "automatic"
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2200,
      "launchAutoHide": true,
      "backgroundColor": "#7FBFE9",
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": true,
      "splashImmersive": true,
      "showSpinner": false
    }
  }
}
